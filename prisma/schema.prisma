datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String  @id
  name           String
  email          String  @unique
  role           String
  active         Boolean @default(true)
  // For "Project Officer": the projects this user may raise requests for.
  projectIdsJson String  @default("[]")
  // Programme-level scope: every project in this stream, present and future.
  streamScope    String  @default("")
  /// Secret for this person's private calendar feed. Null until they ask for one.
  calendarToken  String? @unique
}

model Account {
  code           String  @id
  name           String
  type           String
  currency       String
  parent         String?
  reportingGroup String
  balance        Float   @default(0)
  active         Boolean @default(true)
}

model Donor {
  id           String @id
  name         String
  country      String
  contactEmail String
  notes        String
}

model Project {
  id          String @id
  name        String
  code        String @unique
  donorId     String
  budgetUSD   Float
  // The grant's own currency and the contract amount as signed. budgetUSD stays the
  // USD figure used for cross-project rollups; budgetNative is what the donor agreement
  // says and never moves with the exchange rate.
  currency     String @default("USD")
  budgetNative Float  @default(0)
  startDate   String
  endDate     String
  fundingType String
  status      String
  stream      String @default("")
}

// Funding funnel: money BEFORE it lands. Deliberately a separate table so nothing
// here can ever leak into financial reports, project lists, or balances — an
// opportunity graduates to a Project only through /api/projects/new with bank proof.
model Opportunity {
  id                 String @id
  title              String
  donorId            String @default("")
  stream             String @default("")
  stage              String // Prospect | Drafting | Submitted | Awarded | Declined
  amount             Float  @default(0)
  currency           String @default("USD")
  deadline           String @default("")
  decisionDate       String @default("")
  renewalOfProjectId String @default("")
  notes              String @default("")
  // The call itself — the page you apply on. Kept as its own field, not buried in notes,
  // so every opportunity can be re-opened and re-checked at its source.
  link               String @default("")
  // Published AnaHon work submitted as evidence with this application: [{url, title}].
  // Nearly every funder asks for samples, and the same pieces get reused across
  // applications — so they are links you can click, not prose in `notes`.
  samplesJson        String @default("[]")
  // Proposal workspace: {summary, problem, solution, objectives, deliverables,
  // outputs, outcomes, budget: [{line, description, amount}], timeline: [{activity, start, end}]}
  proposalJson       String @default("{}")
}

model BudgetLine {
  id           String @id
  projectId    String
  code         String
  category     String
  description  String
  allocatedUSD Float
  // Approved amount in the project's own currency — the number in the signed budget.
  allocatedNative Float @default(0)
  actualUSD    Float  @default(0)
  committedUSD Float  @default(0)
}

model Vendor {
  id                String  @id
  name              String
  category          String
  taxId             String
  bankInfo          String
  contact           String
  active            Boolean @default(true)
  declarationSigned Boolean @default(false)
  blocked           Boolean @default(false)
  // Whether this party is ENGAGED under a service agreement (a trainer, editor, consultant)
  // as opposed to bought from (a subscription, a taxi, a shop). Explicit rather than inferred
  // from `category`: a mislabelled category once let a service agreement be drafted with Apple.
  // Defaults false — a new vendor is a supplier until someone deliberately says otherwise.
  engageable        Boolean @default(false)
  // Login email, when this provider is also a system user. Same link Employee.userEmail
  // makes for timesheets — here it lets the approval queue spot a voucher whose requester
  // is its own payee. Empty for ordinary suppliers, which is nearly all of them.
  userEmail         String  @default("")
  /// WhatsApp number in full international form (+961…). Separate from `contact`, which is
  /// free text and holds "N/A" for most rows, an address for one and a number for another —
  /// nothing a link can be built from without guessing. Empty means no WhatsApp button.
  phone             String  @default("")
}

model Expense {
  id              String  @id
  voucherNo       String  @unique
  title           String
  purpose         String
  vendorId        String
  projectId       String
  budgetLineId    String
  currency        String
  amount          Float
  rate            Float
  convertedAmount Float
  whtAmount       Float   @default(0)
  netAmount       Float   @default(0)
  requestorId     String
  status          String
  paymentMethod   String?
  paymentRef      String?
  created_at      String
  approved_at     String?
  paid_at         String?
  /// Who took each step, and the seat they wore at the time (phase 7).
  approvedById    String?
  approvedAs      String?
  paidById        String?
  paidAs          String?
  postedById      String?
  postedAs        String?
  // The approved procurement (RFQ or single-source waiver) authorising a >USD 300 purchase.
  procurementId   String  @default("")
  commentsJson    String  // Serialized Comments Array [Comment]
  allocationsJson String  @default("[]") // Serialized allocations for shared cost splits
  hasAttachment   Boolean @default(false)
}

model Procurement {
  id               String  @id
  title            String
  projectId        String
  budgetLineId     String
  status           String
  quotationsJson   String  // Serialized Quotations Array
  justification    String
  conflictDeclared Boolean @default(false)
  // Waiver: fewer than 3 quotations, allowed only with a written justification.
  singleSource     Boolean @default(false)
  approvedBy       String  @default("")
  approvedById     String?
  approvedAs       String?
}

model BankAccount {
  id         String  @id
  name       String
  type       String
  currency   String
  accountNo  String
  balance    Float
  active     Boolean @default(true)
}

model BankTransaction {
  id            String  @id
  bankAccountId String
  date          String
  description   String
  amount        Float
  type          String
  reconciled    Boolean @default(false)
  voucherNo     String?
  // Outgoing money reaches a project through voucherNo -> Expense.projectId.
  // Incoming money (donor tranches) has no voucher, so it carries the project directly.
  projectId     String?
  // True for lines staged from an eBLOM advice PDF, not yet on an imported statement.
  // Pending lines never enter balances, reports, or funding proof — statements decide.
  pending       Boolean @default(false)
  // eBLOM "Transaction Reference" from the advice, used to dedupe re-imports.
  noticeRef     String?
}

model JournalEntry {
  id          String  @id
  journal     String
  date        String
  description String
  referenceNo String
  isPosted    Boolean @default(false)
  itemsJson   String  // Serialized items: { accountCode, debit, credit, projectId?, donorId? }[]
}

model Employee {
  id            String  @id
  name          String
  position      String
  salary        Float
  allowance     Float
  paymentMethod String
  contractType  String
  active        Boolean @default(true)
  userEmail     String  @default("") // login email for self-service timesheets (Policy 8.5)
  // Which of the two BLOM sub-accounts pays this person. Null means paid in cash.
  // Same shape expenses already use: paymentMethod says how, bankAccountId says from where.
  bankAccountId String?
  /// WhatsApp number in full international form (+961…), for the timesheet and invoice
  /// nudges. Empty means no WhatsApp button — never a guessed country code.
  phone         String  @default("")
  /// When this person's employment began (YYYY-MM-DD, "" if not known yet). The yearly
  /// framework contract's period starts here instead of being guessed each time.
  startDate     String  @default("")
}

model Timesheet {
  id              String  @id
  employeeId      String
  month           String
  totalDays       Int
  allocationsJson String  // Serialized Allocations Array
  status          String
  approvedBy      String?
  approvedById    String?
  approvedAs      String?
}

model FixedAsset {
  id                       String @id
  name                     String
  serialNumber             String
  fundingProjectId         String
  purchaseDate             String
  cost                     Float
  currency                 String
  usefulLifeYears          Int
  custodian                String
  location                 String
  condition                String
  currentBookValue         Float
  depreciationMethod       String
  accumulatedDepreciation  Float
}

model PartnerAccount {
  id                    String @id
  partnerName           String
  capitalBalance        Float
  loansToCompany        Float
  drawingsBalance       Float
  currentAccountBalance Float
}

model AppDoc {
  // Unique document reference (ANH-DOC-NNNNN). Assigned automatically at
  // registration; editable only by the master account (Super Admin).
  refNo String? @unique
  id               String @id
  filename         String
  mimeType         String
  sizeStr          String
  base64           String
  category         String
  linkedRecordType String
  linkedRecordId   String
  created_at       String
  // The person/provider this document is ABOUT (emp-* or ven-*), independent of what it is
  // linked to (project/expense). Explicit so party files never rely on name-in-filename guessing.
  partyId          String?
  contentHash      String @default("") // sha256 of the bytes — the same file never files twice
  note             String @default("") // editable description shown in the materials library
  // Receipt series (Cash Receipt only). The number lives on the record, not just in the
  // filename, so the series can be listed and continued without parsing filenames.
  receiptNo        String?
  // True on the client's signed scan: the same receipt, same number, second row on disk.
  receiptSigned    Boolean @default(false)
}

model AuditLog {
  id        String @id
  userId    String
  userName  String
  action    String
  details   String
  timestamp String
  // The seat the person was standing in, when it was not their own. Null = themselves.
  actingAs  String?
}

model ComplianceTask {
  id       String @id
  title    String
  category String
  dueDate  String
  status   String
  notes    String
  /// User.id of the person whose turn it is. Null = the master account's own checklist.
  assigneeUserId String?
  /// User.id of whoever put the task on the list.
  createdBy      String?
}

// Production stream: paying clients (earned income side). Distinct from Donor
// (gives grants) and Vendor (we pay them) — a Client pays US for services.
model Client {
  id      String  @id
  name    String
  contact String  @default("")
  email   String  @default("")
  phone   String  @default("")
  taxId   String  @default("")
  notes   String  @default("")
  active  Boolean @default(true)
}

// Quotations are forward-looking like Opportunities: a quote is never income.
// Income exists only when the client's payment shows on a bank statement.
model Quotation {
  id          String @id
  quoteNo     String @unique
  clientId    String
  title       String
  description String @default("")
  amount      Float  @default(0)
  currency    String @default("USD")
  date        String @default("")
  validUntil  String @default("")
  status      String @default("Draft") // Draft | Sent | Accepted | Rejected | Expired | Invoiced
  notes       String @default("")
  itemsJson   String @default("[]") // [{service, description, output, unitPrice, qty}]
  termsJson   String @default("{}") // {financial, production, technical, extras}
  paymentTxIdsJson String @default("[]") // statement deposits that settled this quote, in linking order (bank evidence); a client may pay in tranches
}

model OrgSettings {
  id                        String  @id @default("settings")
  profileName               String
  legalEntity               String
  vesselCode                String
  baseCurrency              String  @default("USD")
  fiscalYearEnd             String
  vatRate                   Float
  approvalThresholdUSD      Float
  allowSubProjectAllocation Boolean @default(true)
}

// Physical petty-cash count: what is actually in the drawer, and when it was counted.
// The variance against ledger 1120 is the real undocumented gap.
model CashCount {
  id         String @id
  date       String
  countedUSD Float
  countedBy  String @default("")
  notes      String @default("")
  created_at String
}

// A recurring charge: what renews, when, from which account, and who pays for it.
// matchText links it to statement lines so the last charge can be found automatically.
model Subscription {
  id            String @id
  name          String
  vendorId      String @default("")
  matchText     String @default("")
  amount        Float  @default(0)
  currency      String @default("USD")
  cycle         String @default("Monthly") // Monthly | Quarterly | Annual
  nextRenewal   String @default("")
  bankAccountId String @default("")
  projectId     String @default("")
  budgetLineId  String @default("")
  status        String @default("Active")  // Active | Paused | Cancelled
  // Date someone last confirmed this is still live — a status alone goes stale silently.
  verifiedOn    String @default("")
  notes         String @default("")
  created_at    String
}

// One dated step in a project's life: an activity, a milestone, a report due, a payment
// expected. Assignable, so "who is doing this" is recorded rather than assumed.
model ProjectActivity {
  id             String @id
  projectId      String
  title          String
  detail         String @default("")
  kind           String @default("Activity") // Activity | Milestone | Report | Payment
  dueDate        String @default("")
  assigneeUserId String @default("")
  status         String @default("Planned")  // Planned | In Progress | Done | Cancelled
  budgetLineId   String @default("")
  source         String @default("manual")   // manual | auto | imported
  completedOn    String @default("")
  // Donor activity-timetable fields: "2.1.3", the Result it sits under, the Arabic
  // title, and the periods it runs across (labels from the donor's own grid).
  outlineNo      String @default("")
  resultGroup    String @default("")
  titleAr        String @default("")
  startDate      String @default("")
  periodsJson    String @default("[]")
  created_at     String

  @@index([projectId])
}

model FxRates {
  id  String @id @default("rates")
  EUR Float
  LBP Float
}

// Editorial pipeline (signed Policies 002 & 005): content moves
// Assigned → In Production → Fact-Check → Editorial Review → Approved → Published.
// Fact-check source log, dual approval (Production Manager + Programs Director, two
// distinct users), legal attestation and post-publish corrections live on the row —
// the register enforces the signed policies, it does not invent workflow.
model ContentItem {
  id                  String  @id
  title               String
  contentType         String  @default("Post")   // CONTENT_TYPES — Policy 002 "infographics, reels, …" (the FORMAT)
  // Policy 002 "Content Types": News | Commercial | Opinion, each of which the policy requires be
  // CLEARLY LABELLED on the published piece — "News", "Sponsored"/"Advertisement"/"Paid Content",
  // "Opinion"/"Editorial"/"Commentary". Distinct from contentType above, which is the format.
  // Empty until chosen; publishBlockers refuses to publish an unlabelled piece.
  contentLabel        String  @default("")
  // Commercial only: "Maintain transparency about any commercial relationships or sponsorships
  // associated with the content" (Policy 002). Who paid for it, or what the relationship is.
  sponsorDisclosure   String  @default("")
  stream              String  @default("")       // programme (STREAMS) — POs own their programme's content
  channelsJson        String  @default("[]")     // subset of CONTENT_CHANNELS (Policy 002 channels)
  brief               String  @default("")
  status              String  @default("Assigned") // CONTENT_STATUSES
  assigneeUserId      String  @default("")       // Reporter / Content Creator / Podcaster
  dueDate             String  @default("")       // YYYY-MM-DD — the daily meeting sets deadlines
  assignedMeetingDate String  @default("")       // which daily production meeting assigned it
  reviewedMeetingDate String  @default("")       // which weekly editorial meeting reviewed it
  factCheckerUserId   String  @default("")       // named at submit; must differ from assignee (Policy 005 impartiality)
  factCheckJson       String  @default("[]")     // [{source, step, date}] — "detailed records of all sources and verification steps"
  factCheckPassedAt   String  @default("")       // set only by the named fact-checker; cleared when returned
  checksJson          String  @default("{}")     // CONTENT_CHECKS booleans — each a Policy 002 sentence
  legalFlag           Boolean @default(false)    // "potential legal implications" (Policy 002)
  legalReviewedBy     String  @default("")       // attestation: who performed the review (free text — no legal login exists)
  legalReviewNote     String  @default("")
  legalRecordedBy     String  @default("")       // app user who recorded the attestation
  legalRecordedAt     String  @default("")
  pmApprovedBy        String  @default("")       // userId — Production Manager approval slot
  pmApprovedAt        String  @default("")
  pmApprovedAs        String?
  pdApprovedBy        String  @default("")       // userId — Programs Director approval slot, distinct user
  pdApprovedAt        String  @default("")
  pdApprovedAs        String?
  factCheckTag        Boolean @default(false)    // Policy 005 "tags or labels" — set at publish
  publishedAt         String  @default("")
  websiteUrl          String  @default("")       // where the site put it — written back by the publish hook
  retractedAt         String  @default("")       // taken off the website; the record stays (Policy 005)
  retractReason       String  @default("")
  coverPath           String  @default("")       // vault-relative path of the cover image (GENERAL/Cover/…)
  coverProvider       String  @default("")       // higgsfield | gemini | upload
  correctionsJson     String  @default("[]")     // [{date, nature, correction, by}] — dated public record
  materialsJson       String  @default("[]")     // [{label, url, kind: link|photo|video|doc}] — reference material
  draftsJson          String  @default("[]")     // [{label, kind, text, date, by}] — production drafts the fact-checker verifies
  aiAssisted          Boolean @default(false)    // set automatically when an AI draft is saved; manual toggle for outside tools
  aiDisclosed         Boolean @default(false)    // attestation: watermark/disclaimer on the published piece (golden rule)
  created_at          String
}

// A Facebook Page connected through Meta's login dialog (Social desk, 6 Sep 2026), with the
// Instagram Business account linked to it. The token is a long-lived Page token; it never
// leaves the server. One row per Page — several Pages may be connected.
model SocialAccount {
  id             String  @id                  // the Page id
  name           String
  picture        String  @default("")
  token          String                       // long-lived Page access token — never sent to the browser
  igId           String  @default("")         // linked Instagram Business account, if any
  igUsername     String  @default("")
  connectedBy    String  @default("")         // User.id of whoever pressed Connect
  connectedAt    String
  tokenCheckedAt String  @default("")
  tokenValid     Boolean @default(true)
}

// One social post to one account on one network — the queue the server drains every minute.
// Draft = waits for its content item to pass the editorial gate; Queued = publishes at publishAt;
// Failed = gave up after the retries in src/meta.ts (BACKOFF_MINUTES); every state change is audited.
model SocialPost {
  id            String @id
  accountId     String                         // SocialAccount.id
  network       String                         // facebook | instagram
  contentItemId String @default("")            // the item this post carries, if any (gate + cover)
  message       String @default("")
  link          String @default("")
  imageUrl      String @default("")            // public https URL, or cover:<contentItemId> (bytes from the vault — Facebook only)
  // A carousel: the ordered images, 2..CAROUSEL_MAX of them, same ref shapes as imageUrl. Empty
  // for an ordinary single-image post, which keeps using imageUrl — imagesOf() reads whichever
  // is set, so one accessor is the only source of truth at read time.
  imagesJson    String @default("[]")
  videoRef      String @default("")            // doc:<AppDoc.id> — a video in the vault, uploaded as bytes (Facebook video/Reel, Instagram Reel)
  asReel        Boolean @default(false)        // Facebook: post the video as a Reel rather than a Page video (Instagram is always a Reel)
  containerId   String @default("")            // Instagram container awaiting FINISHED while the row is Publishing
  publishAt     String                         // ISO
  state         String @default("Queued")      // Draft | Queued | Publishing | Published | Failed | Cancelled
  attempts      Int    @default(0)
  lastError     String @default("")
  postId        String @default("")
  permalink     String @default("")
  statsJson     String @default("{}")          // {likes, comments, shares} refreshed every 15 minutes for a month
  createdBy     String @default("")
  createdAt     String
  publishedAt   String @default("")

  @@index([state, publishAt])
}

// One held editorial meeting (Policy 002 defines both kinds with participants and
// agenda). The weekly card derives its agenda from the content register; this row
// records what the derivation can't know: who attended, the week's direction, and
// the decisions taken. One row per meeting day per kind.
model EditorialMeeting {
  id            String @id
  kind          String @default("Weekly Editorial") // Weekly Editorial | Daily Production
  date          String                              // YYYY-MM-DD
  attendeesJson String @default("[]")               // userIds present (002 names the expected roles)
  direction     String @default("")                 // "Planning for upcoming content and coverage" (002)
  notes         String @default("")                 // issues addressed, decisions, performance review (002)
  minutes       String @default("")                 // pasted transcript or in-app recording transcription
  topicsJson    String @default("[]")               // [{topic, note}] — documented topics, seeds for the idea desk
  recordedBy    String @default("")
  created_at    String

  @@unique([kind, date])
}

// People met at trainings, conferences and events — the networking register.
// Deliberately NOT Client/Vendor/Donor: those are billing and funding parties in the
// books, and a roster of forty boot-camp participants does not belong in production
// revenue. Nothing here ever touches a ledger.
/// An event or engagement: one we attended, or one we ran. `projectId` is null for the
/// many that belong to no project. See migration 20260905190000_engagement_register.
model Engagement {
  id         String  @id
  title      String
  kind       String  @default("Conference")   // Conference | Bootcamp | Training | Coaching | Workshop | Meeting | Other
  ourPart    String  @default("Attended")     // Attended | Delivered | Co-hosted | Sponsored
  org        String  @default("")             // who ran it
  place      String  @default("")
  startDate  String  @default("")             // YYYY-MM-DD
  endDate    String  @default("")
  stream     String  @default("")             // STREAMS — which programme it serves
  projectId  String?
  outcome    String  @default("")             // what came of it
  notes      String  @default("")
  created_at String

  @@index([startDate])
  @@index([projectId])
}

model NetworkContact {
  id         String  @id
  name       String
  nameAr     String  @default("")
  org        String  @default("")
  role       String  @default("")
  country    String  @default("")
  email      String  @default("")
  phone      String  @default("")
  links      String  @default("")                // profile URLs, one per line
  kind       String  @default("Participant")     // Trainer | Participant | Organiser | Speaker | Other
  metAt      String  @default("")                // the event, as text — the label for anything with no record of its own
  engagementId String?                              // …or the engagement record itself
  metOn      String  @default("")                // YYYY-MM-DD
  stream     String  @default("")                // STREAMS — which programme this contact serves
  followUp   String  @default("")                // what we actually want from them
  followUpBy String  @default("")                // YYYY-MM-DD
  status     String  @default("New")             // New | Contacted | Warm | Dormant
  notes      String  @default("")
  created_at String

  @@index([metAt])
  @@index([engagementId])
}

// Software the newsroom evaluates and uses. Separate from Subscription on purpose:
// Subscription is a money record that drives bank matching and renewal alerts, so a
// register of free tools would bury the real charges. A tool graduates INTO a
// subscription when it starts costing — `subscriptionId` is that bridge.
model Tool {
  id             String @id
  name           String
  url            String @default("")
  category       String @default("Other")
  purpose        String @default("")            // what we actually use it for
  stream         String @default("")            // STREAMS — which programme
  status         String @default("Evaluating")  // Evaluating | Trialling | In use | Dropped
  pricing        String @default("Free")        // Free | Free tier | Trial | Paid | Pay-as-you-go
  owner          String @default("")            // who on the team owns it
  source         String @default("")            // where we found it (event, person)
  addedOn        String @default("")            // YYYY-MM-DD
  reviewBy       String @default("")            // YYYY-MM-DD — a trial with no date silently lapses
  subscriptionId String @default("")            // set once it becomes a real charge
  notes          String @default("")
  created_at     String

  @@index([category])
}

/// One row per person per desk item that has been pushed to a calendar (phase 6).
/// Its whole job is to stop the same reminder being created twice.
model Reminder {
  id            String  @id
  userId        String
  /// The desk item's stable id, e.g. "expenses:e-12" — see src/workflow.ts.
  itemId        String
  googleEventId String?
  calendarId    String  @default("primary")
  title         String
  whenDate      String
  /// "active" while the work is owed; "cancelled" once it left the desk. Never deleted.
  state         String  @default("active")
  createdAt     String
  updatedAt     String

  /// Which way this reminder was delivered: "calendar" (Google/ics) or "push" (the phone).
  /// The two ledgers are separate on purpose — a calendar cannot carry undated work, and a
  /// push has no event to correct later, so the same desk item may be owed on both.
  channel       String  @default("calendar")

  @@unique([userId, itemId, channel])
  @@index([userId, state])
}

/// One browser or installed phone app that has agreed to receive "it is your turn".
/// The endpoint is the address the push service gave that install; it is the identity,
/// which is why it is unique — reinstalling produces a new one and the old row is dead
/// until the push service answers 404/410 and the sender deletes it.
model PushSubscription {
  id        String @id
  userId    String
  endpoint  String @unique
  p256dh    String
  auth      String
  createdAt String

  @@index([userId])
}

// What a platform has done over a stretch of time — the long series the live Meta pull cannot give.
//
// Meta refuses any page-insights window longer than 93 days (src/insights.ts `windowFor`), so
// "how is this month going" is the only question the API can answer. Lifetime figures were being
// quoted to funders out of PDFs in Google Drive. One row here is one platform over one period,
// typed in by hand or off an export, and the live pull NEVER writes to this table.
//
// Aggregates only — no person, no post, nothing identifying (Data Protection Policy 024, draft).
// Audience geography is a sentence in `note`, not a model: it is read by someone writing a
// proposal, never summed.
//
// Every count is nullable on purpose. A platform that does not report a metric (YouTube has no
// "reach") must read "—", never 0: a zero in a funder's proposal is a claim, an absence is not.
// `followers` is the total at the end of the period; `followersGained` is new followers in it —
// two columns because the seed exports carry both kinds and one column would silently mix a
// stock with a flow.
model SocialPeriod {
  id              String  @id
  platform        String                        // Facebook | Instagram | YouTube | TikTok, or a named combination the export did not split
  periodStart     String                        // YYYY-MM-DD
  periodEnd       String
  followers       Int?                          // total at periodEnd
  followersGained Int?                          // new during the period
  reach           Int?
  impressions     Int?
  views           Int?
  interactions    Int?
  basis           String  @default("unknown")   // organic | includes paid | unknown — a reach figure means nothing without it
  source          String  @default("")          // the export or screen this was read off
  note            String  @default("")          // anything the columns cannot hold, in words
  recordedById    String  @default("")
  recordedBy      String  @default("")
  created_at      String
}
